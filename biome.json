{
    "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
    "files": {
        "includes": [
            "src/**",
            "styles/**",
            "test/**",
            "examples/**",
            "*.html",
            "*.js",
            "*.json",
            "!**/.kilo"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    }
}
